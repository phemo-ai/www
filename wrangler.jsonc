// Static site on Cloudflare Workers (static assets). The worker runs only for "/" (language) and "/lang/*".
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "phemo-www",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "routes": [{ "pattern": "phemo.app", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/", "/lang/*"]
  }
}
